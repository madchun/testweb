{
  "name": "student-pilot-photo-generator",
  "version": "1.0.0",
  "description": "AI-powered student pilot photo generator with Google Drive integration",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "NODE_ENV=production node server/production.js",
    "dev": "nodemon server/index.js",
    "ip": "node server/get-ip.js",
    "docker:build": "docker build -t pilot-photo-generator .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f pilot-app"
  },
  "keywords": ["ai", "image-generation", "google-drive", "pilot-photos"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "axios": "^1.6.2",
    "form-data": "^4.0.0",
    "googleapis": "^128.0.0",
    "@google/generative-ai": "^0.1.3",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
