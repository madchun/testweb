# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Webhook URL for image upload (e.g., N8N, Make, or custom endpoint)
# This endpoint should accept a POST request with base64 image data
# and return a JSON response with the public URL
VITE_WEBHOOK_URL=your_webhook_url_here
